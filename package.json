{
  "name": "bugbottle",
  "version": "1.0.1",
  "description": "Self-hosted Sentry alternative for in-app bug reporting and user feedback: console errors, page context and an optional screenshot. Your UI, your endpoint.",
  "keywords": [
    "bug-report",
    "bug-reporting",
    "error-reporting",
    "error-tracking",
    "feedback",
    "feedback-widget",
    "headless",
    "screenshot",
    "console",
    "error-context",
    "self-hosted",
    "sentry-alternative",
    "react",
    "i18n",
    "widget",
    "feedback-button"
  ],
  "author": "Mads Holst Jensen <mads@mahope.dk> (https://mahoje.dk)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahope/bugbottle.git"
  },
  "homepage": "https://bugbottle.dev",
  "bugs": "https://github.com/mahope/bugbottle/issues",
  "funding": "https://donate.stripe.com/7sYeVcbn50wieFM8gDbMQ0c",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "default": "./dist/svelte/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "default": "./dist/solid/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./html-to-image": {
      "types": "./dist/html-to-image.d.ts",
      "default": "./dist/html-to-image.js"
    },
    "./annotate": {
      "types": "./dist/annotate.d.ts",
      "default": "./dist/annotate.js"
    },
    "./breadcrumbs": {
      "types": "./dist/breadcrumbs.d.ts",
      "default": "./dist/breadcrumbs.js"
    },
    "./network": {
      "types": "./dist/network.d.ts",
      "default": "./dist/network.js"
    },
    "./perf": {
      "types": "./dist/perf.d.ts",
      "default": "./dist/perf.js"
    },
    "./rrweb": {
      "types": "./dist/rrweb.d.ts",
      "default": "./dist/rrweb.js"
    },
    "./sign": {
      "types": "./dist/sign.d.ts",
      "default": "./dist/sign.js"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "default": "./dist/queue.js"
    },
    "./queue-idb": {
      "types": "./dist/queue-idb.d.ts",
      "default": "./dist/queue-idb.js"
    },
    "./triggers": {
      "types": "./dist/triggers.d.ts",
      "default": "./dist/triggers.js"
    },
    "./shake": {
      "types": "./dist/shake.d.ts",
      "default": "./dist/shake.js"
    },
    "./locales": {
      "types": "./dist/locales.d.ts",
      "default": "./dist/locales.js"
    },
    "./locales-extra": {
      "types": "./dist/locales-extra.d.ts",
      "default": "./dist/locales-extra.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./report.schema.json": "./dist/report.schema.json",
    "./openapi.json": "./dist/openapi.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node --experimental-strip-types scripts/build-schema.ts && node --experimental-strip-types scripts/build-openapi.ts && node scripts/build-iife.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "a11y": "node scripts/a11y-audit.mjs && node scripts/a11y-site.mjs",
    "shot:panel": "node scripts/capture-panel.mjs",
    "shot:og": "node scripts/render-og.mjs",
    "smoke:annotate": "node scripts/annotate-smoke.mjs",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check:dist": "node scripts/check-dist.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run build:docs && npm run check:dist",
    "prepublishOnly": "npm run check",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "html-to-image": "^1.11.0",
    "react": ">=18",
    "solid-js": ">=1.8",
    "svelte": ">=4",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "html-to-image": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "ajv": "8.20.0",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "html-to-image": "^1.11.13",
    "marked": "18.0.14",
    "react": "^19.3.0",
    "react-dom": "19.3.0",
    "solid-js": "1.9.15",
    "svelte": "5.57.1",
    "ts-json-schema-generator": "2.9.0",
    "typescript": "^5.7.0",
    "vue": "3.5.43"
  },
  "engines": {
    "node": ">=18"
  }
}
