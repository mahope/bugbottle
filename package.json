{
  "name": "bugbottle",
  "version": "0.6.0",
  "description": "Headless in-app bug reports that arrive with the evidence attached: console errors, page context and an optional screenshot. Your UI, your endpoint.",
  "keywords": [
    "bug-report",
    "bug-reporting",
    "feedback",
    "feedback-widget",
    "headless",
    "screenshot",
    "console",
    "error-context",
    "react",
    "i18n",
    "widget",
    "feedback-button"
  ],
  "author": "Mads Holst Jensen <mads@mahope.dk> (https://mahoje.dk)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahope/bugbottle.git"
  },
  "homepage": "https://bugbottle.dev",
  "bugs": "https://github.com/mahope/bugbottle/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "default": "./dist/svelte/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./html-to-image": {
      "types": "./dist/html-to-image.d.ts",
      "default": "./dist/html-to-image.js"
    },
    "./annotate": {
      "types": "./dist/annotate.d.ts",
      "default": "./dist/annotate.js"
    },
    "./breadcrumbs": {
      "types": "./dist/breadcrumbs.d.ts",
      "default": "./dist/breadcrumbs.js"
    },
    "./network": {
      "types": "./dist/network.d.ts",
      "default": "./dist/network.js"
    },
    "./perf": {
      "types": "./dist/perf.d.ts",
      "default": "./dist/perf.js"
    },
    "./sign": {
      "types": "./dist/sign.d.ts",
      "default": "./dist/sign.js"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "default": "./dist/queue.js"
    },
    "./triggers": {
      "types": "./dist/triggers.d.ts",
      "default": "./dist/triggers.js"
    },
    "./locales": {
      "types": "./dist/locales.d.ts",
      "default": "./dist/locales.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./report.schema.json": "./dist/report.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node --experimental-strip-types scripts/build-schema.ts && node scripts/build-iife.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "a11y": "node scripts/a11y-audit.mjs",
    "smoke:annotate": "node scripts/annotate-smoke.mjs",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build && npm run build:docs",
    "prepublishOnly": "npm run check",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "html-to-image": "^1.11.0",
    "react": ">=18",
    "svelte": ">=4",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "html-to-image": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.0",
    "ajv": "8.20.0",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.0",
    "html-to-image": "^1.11.13",
    "marked": "18.0.12",
    "react": "^19.2.8",
    "react-dom": "19.2.8",
    "svelte": "5.57.0",
    "ts-json-schema-generator": "2.9.0",
    "typescript": "^5.7.0",
    "vue": "3.5.42"
  },
  "engines": {
    "node": ">=18"
  }
}
