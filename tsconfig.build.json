{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src"],
  // The two script-tag entries and the module they share are esbuild's and
  // nothing else: two of them declare a version constant that only esbuild
  // defines, so tsc has nothing sensible to emit for them. `npm run typecheck` still
  // covers all three.
  "exclude": ["src/global.ts", "src/global-slim.ts", "src/global-shared.ts"]
}
