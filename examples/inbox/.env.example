# Copy to `.env` beside this file. `.env` is gitignored; keep it that way.
#
# A password worth having is one nobody typed:
#
#   openssl rand -base64 24
#
INBOX_PASSWORD=

# The one site allowed to post reports from a browser, if it is not this one.
# A wildcard is not an option: it would let any page on the internet fill the
# volume, and the volume is where the pictures are.
# ALLOWED_ORIGIN=https://app.example.com

# How many reports are kept before the oldest are deleted. 0 switches the cap
# off and makes the disk the ceiling.
# MAX_REPORTS=2000

# How long a report is kept, in days. Unset or 0 keeps every report the cap
# leaves, for as long as the volume lasts. Set it and reports older than this
# are deleted — JSON and screenshot together — when the inbox starts and once
# an hour after that. How long you may keep somebody's screenshot is your
# decision, so nothing here makes it for you.
# RETENTION_DAYS=90

# One JSON line per decision on stdout: status, reason, address, fingerprint
# and time. Never the message, the contact line or the picture. Off unless
# this is exactly 1.
# AUDIT_LOG=1

# The address the feeds and the notifications link to. Taken from the request
# otherwise, which is right behind a proxy that passes the host through and
# wrong behind one that rewrites it. A notification has no request to ask, so
# set this as soon as anything below is set.
# PUBLIC_URL=https://bugs.example.com

# Where a new report is announced. Slack, Discord and Teams webhooks are
# recognised by their host and get a message built for them; anything else is
# posted the whole report as JSON. This URL is a credential — anyone holding it
# can post to that channel — so it belongs here and nowhere else.
# NOTIFY_WEBHOOK=https://hooks.slack.com/services/T000/B000/xxxxxxxx
# NOTIFY_KIND=slack

# Or a mail per report, through any SMTP account. HOST switches it on; FROM and
# TO are required with it. Without USER and PASS no AUTH is attempted at all,
# and AUTH is refused outright over a connection that is not encrypted.
# NOTIFY_SMTP_HOST=smtp.example.com
# NOTIFY_SMTP_PORT=587
# NOTIFY_SMTP_USER=
# NOTIFY_SMTP_PASS=
# NOTIFY_SMTP_FROM=bugs@example.com
# NOTIFY_SMTP_TO=team@example.com
