# Copy to `.env` beside this file. `.env` is gitignored; keep it that way.
#
# A password worth having is one nobody typed:
#
#   openssl rand -base64 24
#
INBOX_PASSWORD=

# The one site allowed to post reports from a browser, if it is not this one.
# A wildcard is not an option: it would let any page on the internet fill the
# volume, and the volume is where the pictures are.
# ALLOWED_ORIGIN=https://app.example.com

# How many reports are kept before the oldest are deleted. 0 switches the cap
# off and makes the disk the ceiling.
# MAX_REPORTS=2000
